{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@pbl/db": ["../../packages/db/src"],
      "@pbl/db/client": ["../../packages/db/src/client.ts"],
      "@pbl/db/scripts/migrate": ["../../packages/db/scripts/migrate.ts"],
      "@pbl/types": ["../../packages/types/src"],
      "@pbl/validators": ["../../packages/validators/src"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
