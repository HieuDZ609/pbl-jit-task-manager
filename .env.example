# Auth.js
AUTH_SECRET=your-auth-secret
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pbl_jit

# Bypass auth ở non-production (dev local + E2E). Interop: middleware và
# currentUserId() cùng đọc cờ này; xoá khi có Google credential thật.
PBL_AUTH_BYPASS=false
