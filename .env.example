# Auth.js
AUTH_SECRET=your-auth-secret
# Dev chạy HTTPS tại https://localhost:5678 (redirect URI đã khai trên Google
# Console: https://localhost:5678/auth/callback/google). Auth.js luôn dùng
# `<baseUrl><basePath>/callback/google` — bắt buộc basePath của app khớp URI.
AUTH_URL=https://localhost:5678
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pbl_jit

# Bypass auth ở non-production (dev local + E2E). Interop: middleware và
# currentUserId() cùng đọc cờ này; xoá khi có Google credential thật.
PBL_AUTH_BYPASS=false
